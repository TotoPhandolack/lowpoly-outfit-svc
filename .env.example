PORT=3001
CORS_ORIGINS=http://localhost:3000

# Copy the pooled connection string from your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for model uploads and deletion; use a long random value.
API_ADMIN_TOKEN=

# Cloudinary API credentials from the Cloudinary console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MODEL_FOLDER=lowpoly-outfit/models
